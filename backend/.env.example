# ============================================
# GENERAL CONFIGURATION
# ============================================
NODE_ENV=development
PORT=4000

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=your_bot_username

# Telegram Webhook (OPTIONAL for local development)
# Leave empty for local dev - bot will use polling mode instead
# For production: https://your-domain.com/api/telegram/webhook
# TELEGRAM_WEBHOOK_URL=

# Relayer Configuration
# Telegram ID of the account that receives gifts
RELAYER_TELEGRAM_ID=your-telegram-id

# ============================================
# DATABASE CONFIGURATION (SUPABASE)
# ============================================
# Option 1: Direct Connection (Recommended for Development & Migrations)
# Get this from Supabase Dashboard → Settings → Database → Connection String → URI
# Format: postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your-password@db.xxxxxxxxxxxxx.supabase.co:5432/postgres"

# Option 2: Connection Pooling (Recommended for Production/Serverless)
# Get this from Supabase Dashboard → Settings → Database → Connection Pooling → Transaction
# Uncomment and use this instead of DATABASE_URL for serverless deployments:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# If using connection pooling above, also set direct URL for migrations:
# DIRECT_URL="postgresql://postgres:your-password@db.xxxxxxxxxxxxx.supabase.co:5432/postgres"

# ============================================
# LEGACY DATABASE CONFIGURATION (NOT NEEDED WITH SUPABASE)
# ============================================
# These were for local Docker PostgreSQL setup
# When using Supabase, you can delete these variables:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=rocket_user
# DB_PASSWORD=strongpassword
# DB_NAME=rocket_gifts

# ============================================
# REDIS CONFIGURATION (OPTIONAL)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ============================================
# WEBAPP CONFIGURATION
# ============================================
# This is your frontend URL that opens when users click "Launch App"
# For local dev: http://localhost:8000
# For production: https://your-domain.com (must be HTTPS)
WEBAPP_URL=http://localhost:8000

# ============================================
# SECURITY
# ============================================
# JWT Secret (for initData validation)
# Generate a random secret for production
# Example: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Follow SUPABASE_SETUP.md for detailed Supabase setup
# 3. Replace all placeholder values with your actual values
# 4. Never commit .env file to git (it's in .gitignore)
